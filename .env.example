# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
MONGODB_URI=mongodb://127.0.0.1:27017/blood-donate-bd
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: server চালানোর port (default 3000). Real-time chat-এর জন্য `npm start` / `npm run dev` (custom server) ব্যবহার করুন।
PORT=3000

# Top Donor র‍্যাংকিং-এর রাত ১২টার (Asia/Dhaka) স্বয়ংক্রিয় আপডেট। যেকোনো লম্বা random string দিন (custom server চালালে নিজেই চলে)।
# বাইরের cron হলে: POST /api/cron/ranking  (Header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Push Notification (Web Push / VAPID)। key বানাতে: npx web-push generate-vapid-keys
# VAPID_SUBJECT হবে আপনার ইমেইল (mailto:…) অথবা সাইটের https লিংক। key না দিলে Push বন্ধ থাকে, কিন্তু Notification bell কাজ করে।
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
